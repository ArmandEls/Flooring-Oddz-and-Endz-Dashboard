# Copy this file to .env and fill in your own values. Never commit .env.

# Port the dashboard server listens on
PORT=3000

# Cin7 Core (DEAR Systems) API credentials.
# Find these in Cin7 Core under Integrations & Add-ons > API.
# Leave blank to run the dashboard without the stock take losses panel.
CIN7_ACCOUNT_ID=
CIN7_APPLICATION_KEY=

# How many days back to look for stock take losses (capped at 60 / 2 months)
STOCK_LOSS_DAYS=60

# Only needed on a machine running scripts/push-losses.js (the relay) to
# push data to a deployed dashboard that can't reach Cin7 Core itself.
# DASHBOARD_URL=https://your-deployed-dashboard.onrender.com
# RELAY_TOKEN=

# Only needed on the deployed instance if it should accept relayed pushes
# (must match the relay machine's RELAY_TOKEN above).
# RELAY_TOKEN=

# Only needed on a machine running scripts/send-weekly-report.js. SMTP
# credentials for the account the weekly report is sent FROM (e.g. Microsoft
# 365: smtp.office365.com, port 587). SMTP_USER/PASS is that mailbox's
# address and app password. REPORT_TO defaults to SMTP_USER if not set.
# DASHBOARD_URL must also be set (see relay section above) — the report
# reads its numbers from the live dashboard, not from Cin7 directly.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# REPORT_TO=
# REPORT_FROM=
